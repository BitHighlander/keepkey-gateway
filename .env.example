# Required outside Docker Compose. Compose supplies its own local value.
DATABASE_URL=postgres://pioneer:pioneer@localhost:5432/pioneer

# Optional. When absent, Zerion routes report feature_unavailable without
# preventing the wallet core from starting.
ZERION_API_KEY=

# Required for EVM balances, nonces, gas, and ERC-20 reads.
NOWNODES_API_KEY=

# Required for CAIP-to-USD market prices.
COINGECKO_API_KEY=

# Required for the independent SwapKit route and affiliate account.
SWAPKIT_API_KEY=

# Required for direct 0x executable quotes. Canonicalized from the legacy
# invalid shell identifier `0X_API_SECRET`.
ZEROX_API_KEY=

# Sponsored Hive onboarding. Read-only Hive support needs none of these.
# Creation remains disabled unless the explicit switch is true; the gateway
# also requires device attestation, a funded ETH proof, and PostgreSQL dedup.
HIVE_ONBOARDING_ENABLED=false
HIVE_SPONSOR_ACCOUNT=
HIVE_SPONSOR_ACTIVE_WIF=

# Optional runtime sizing. These defaults are intentionally conservative.
PORT=12000
DATABASE_MAX_CONNECTIONS=5
